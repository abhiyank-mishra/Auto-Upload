# --- YouTube Upload (OAuth 2.0) ---
# Path to your OAuth client_secret JSON file downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# Default upload visibility: public, unlisted, or private
YOUTUBE_DEFAULT_VISIBILITY=unlisted

# --- Optional Settings ---
# Max concurrent yt-dlp fragment downloads (speeds up downloads)
CONCURRENT_FRAGMENTS=4
# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base
